<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeepLinkNotificationRouting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DeepLinkNotificationRouting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              (1) DEEP LINK - custom URI scheme.
              No verification. Any app on the device may also declare
              scheme="app" host="routing", which makes Android show a
              disambiguation chooser. Ownership is NOT enforceable.
              Only reachable from adb, another app, or a notification.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app" android:host="routing" />
            </intent-filter>

            <!--
              (2) APP LINK - verified https.
              android:autoVerify="true" makes Android fetch
              https://deeplink-routing.web.app/.well-known/assetlinks.json
              at install time and confirm this package + signing SHA-256
              is listed there. Once verified, this app owns these URLs
              exclusively: no chooser, no hijacking, and taps from Gmail,
              Chrome, WhatsApp etc. land directly in the app.
              If the app is NOT installed, the same URL opens the web page.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="deeplink-routing.web.app"
                    android:pathPrefix="/routing" />
            </intent-filter>
        </activity>

        <service
            android:name=".fcm.AppFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
